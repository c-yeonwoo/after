    "check:tooling": "node --test scripts/check-native-tooling.mjs",
    "check:meet": "bun scripts/check-meet-time.ts",
    "release:check": "npm run check && npx supabase test db && npm run test:meeting-concurrency && npm run test:notification-concurrency && npm run test:ai-concurrency",
